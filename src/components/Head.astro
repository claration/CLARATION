---
import { SEO } from "astro-seo";
import {
    GITHUB_URL,
    SITE_DESC,
    SITE_TITLE,
    WEBSITE_URL,
} from "@/utils/constants";

const { title, ogImage } = Astro.props;

const CANONICAL_URL = new URL(Astro.url.pathname, WEBSITE_URL);
const DEFAULT_IMAGE = `${GITHUB_URL}.png`;
---

<SEO
    title=`🌱 ${title ?? SITE_TITLE}`
    description={SITE_DESC}
    canonical={CANONICAL_URL}
    extend={{
        link: [
            {
                rel: "icon",
                href: DEFAULT_IMAGE,
            },
        ],
        meta: [
            {
                name: "twitter:title",
                content: `${title ?? "🌱 " + SITE_TITLE}`,
            },
            {
                name: "twitter:description",
                content: SITE_DESC,
            },
            {
                name: "twitter:image",
                content: ogImage,
            },
            {
                name: "twitter:url",
                content: Astro.url,
            },
            {
                name: "twitter:card",
                content: "summary_large_image",
            },
            {
                property: "og:title",
                content: `${title ?? "🌱 " + SITE_TITLE}`,
            },
            {
                property: "og:description",
                content: SITE_DESC,
            },
            {
                property: "og:image",
                content: ogImage,
            },
            {
                property: "og:url",
                content: Astro.url,
            },
            {
                property: "og:type",
                content: "website",
            },
        ],
    }}
/>

<meta name="generator" content={Astro.generator} />
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="darkreader-lock" />

<script id="discord:component-embed" type="application/json" set:html={JSON.stringify({
    component: {
        type: 17,
        accent_color: 14446451,
        components: [
            {
                type: 9,
                components: [
                    {
                        type: 10,
                        content: "## About Me\nHey! My name is **C**, or as you may know me as \"CLARATION\"! I'm a passionate programmer for Apple platforms, interested in pushing the limits on what these platforms can do, and highly interested in LLVM and other native technologies!"
                    }
                ],
                accessory: {
                    type: 11,
                    media: {
                        url: DEFAULT_IMAGE
                    }
                }
            },
            {
                type: 14
            },
            {
                type: 1,
                components: [
                    { type: 2, style: 5, url: `${CANONICAL_URL}posts`, label: "📝 Blog" },
                    { type: 2, style: 5, url: GITHUB_URL, label: "👾 Github" },
                ]
            },
        ]
    }
}, null, 2)} />
